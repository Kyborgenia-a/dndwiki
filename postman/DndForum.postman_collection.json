        {
          "name": "01 Gauti kategorijų sąrašą",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statusas 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Turinio tipas JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('json'));",
                  "pm.test('Grąžinamas puslapis su items ir links', () => { const body = pm.response.json(); pm.expect(body.items).to.be.an('array'); pm.expect(body.totalCount).to.be.a('number'); pm.expect(body.links.map(l => l.rel)).to.include('self'); });",
                  "pm.test('Yra pradinės kategorijos', () => pm.expect(pm.response.json().totalCount).to.be.at.least(5));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/categories"
          }
        },
        {
          "name": "02 Sukurti kategoriją",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statusas 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Turinio tipas JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('json'));",
                  "pm.test('Yra Location antraštė', () => pm.expect(pm.response.headers.get('Location')).to.be.a('string'));",
                  "const category = pm.response.json();",
                  "pm.collectionVariables.set('categoryId', category.id);",
                  "pm.collectionVariables.set('categoryName', category.name);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/categories",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo kategorija {{$timestamp}}\",\n  \"description\": \"Kategorija, sukurta Postman testų metu.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
