    {
      "name": "2. Puslapiavimas, filtrai, hypermedia, panelė",
      "item": [
        {
          "name": "Puslapiavimas: 1 puslapis po 1 įrašą",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statusas 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Grąžinamas puslapis su items ir links', () => { const body = pm.response.json(); pm.expect(body.items).to.be.an('array'); pm.expect(body.totalCount).to.be.a('number'); pm.expect(body.links.map(l => l.rel)).to.include('self'); });",
                  "const body = pm.response.json();",
                  "pm.test('Grąžintas 1 įrašas', () => pm.expect(body.items.length).to.eql(1));",
                  "pm.test('Yra keli puslapiai', () => pm.expect(body.totalPages).to.be.at.least(2));",
                  "pm.test('Yra nuoroda next', () => pm.expect(body.links.map(l => l.rel)).to.include('next'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/categories/1/posts?page=1&pageSize=1"
          }
        },
        {
          "name": "Puslapiavimas: 2 puslapis",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statusas 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Grąžinamas puslapis su items ir links', () => { const body = pm.response.json(); pm.expect(body.items).to.be.an('array'); pm.expect(body.totalCount).to.be.a('number'); pm.expect(body.links.map(l => l.rel)).to.include('self'); });",
                  "const body = pm.response.json();",
                  "pm.test('Puslapio numeris 2', () => pm.expect(body.page).to.eql(2));",
                  "pm.test('Yra nuoroda previous', () => pm.expect(body.links.map(l => l.rel)).to.include('previous'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/categories/1/posts?page=2&pageSize=1"
          }
        },
        {
          "name": "Filtravimas: kategorijų paieška",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statusas 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Grąžinamas puslapis su items ir links', () => { const body = pm.response.json(); pm.expect(body.items).to.be.an('array'); pm.expect(body.totalCount).to.be.a('number'); pm.expect(body.links.map(l => l.rel)).to.include('self'); });",
                  "const items = pm.response.json().items;",
                  "pm.test('Rasta bent viena kategorija', () => pm.expect(items.length).to.be.at.least(1));",
                  "pm.test('Visos atitinka paiešką', () => items.forEach(c => pm.expect((c.name + ' ' + c.description).toLowerCase()).to.include('burt')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/categories?search=burt"
          }
        },
        {
          "name": "Filtravimas: įrašai pagal datą",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statusas 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Grąžinamas puslapis su items ir links', () => { const body = pm.response.json(); pm.expect(body.items).to.be.an('array'); pm.expect(body.totalCount).to.be.a('number'); pm.expect(body.links.map(l => l.rel)).to.include('self'); });",
                  "const items = pm.response.json().items;",
                  "pm.test('Rasta bent vienas įrašas', () => pm.expect(items.length).to.be.at.least(1));",
                  "pm.test('Visi sukurti po nurodytos datos', () => items.forEach(p => pm.expect(p.createdAt >= '2026-09-02').to.be.true));",
                  "pm.test('Filtras išlieka nuorodose', () => pm.expect(pm.response.json().links[0].href).to.include('createdFrom'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
