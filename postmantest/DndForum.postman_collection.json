          "name": "01 Gauti visas kategorijas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statusas 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Turinio tipas JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('json'));",
                  "pm.test('Grąžinamas masyvas', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "pm.test('Yra pradinės kategorijos', () => pm.expect(pm.response.json().length).to.be.at.least(4));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/categories"
          }
        },
        {
          "name": "02 Sukurti kategoriją",
