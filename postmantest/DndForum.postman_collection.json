              "raw": "{\n  \"name\": \"Demo kategorija {{$timestamp}}\",\n  \"description\": \"Kategorija, sukurta Postman testų metu.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
